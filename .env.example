# docker compose reads this file. Copy to .env and set real values.
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-48
DEVICE_API_KEY=change-me-must-match-the-firmware
ENVIRONMENT=production
CORS_ORIGINS=http://localhost

# --- automation (optional, see docs/AUTOMATION.md) ---------------------------
# Leave empty to run without n8n. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTOMATION_API_KEY=
# Self-hosted n8n from the compose `automation` profile:
#   AUTOMATION_WEBHOOK_BASE=http://n8n:5678/webhook
AUTOMATION_WEBHOOK_BASE=
AUTOMATION_WEBHOOK_TOKEN=
N8N_ENCRYPTION_KEY=

# --- AI assistant (optional, see docs/AI_ASSISTANT.md) ------------------------
# auto = Claude if ANTHROPIC_API_KEY is set, else the free local Ollama model.
# ollama = always use the free local model.  anthropic = always Claude.
AI_PROVIDER=auto
# Free: install Ollama (ollama.com). launch.bat downloads the models the
# first time (qwen2.5:3b for staff, qwen2.5:1.5b for students).
# Docker reaches Ollama on this computer at this address (default):
# OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
# Student chat model, kept loaded next to the staff one. Empty = share the
# staff model (for GPUs with less than 4 GB).
OLLAMA_STUDENT_MODEL=qwen2.5:1.5b
# true = run the AI on the processor only (use if Ollama reports a CUDA error)
OLLAMA_CPU_ONLY=false
AI_STUDENT_ENABLED=true
# Paid alternative: key from console.anthropic.com
ANTHROPIC_API_KEY=

# --- Self-service sign-up (login page "Sign up" tab) ---
# Sign-up only creates STUDENT accounts. Each gets the next door identity
# (USERn); it opens nothing until staff enrol that person's fingerprint/face.
SIGNUP_ENABLED=true
# Restrict to university emails, e.g. giu-uni.de (empty = any domain)
SIGNUP_EMAIL_DOMAINS=
# true = new accounts stay disabled until an admin activates them
SIGNUP_REQUIRES_APPROVAL=false
# Optional host ports (defaults shown). Change them only to run a second copy of the stack next to an existing one.
# SMARTLAB_HTTP_PORT=80
# SMARTLAB_HTTP_ALT_PORT=8080
# SMARTLAB_HTTPS_PORT=443
# SMARTLAB_HTTPS_ALT_PORT=8443
# SMARTLAB_API_PORT=8000
# SMARTLAB_DB_PORT=5433
# SMARTLAB_N8N_PORT=5678

# First-run passwords for the seeded accounts (admin@, ramy@/hemaly@, ali@giu-uni.de). Leave empty for a random
# password nobody knows, then set one with: docker compose exec backend python set_password.py <email>
# SEED_ADMIN_PASSWORD=
# SEED_STAFF_PASSWORD=
# SEED_STUDENT_PASSWORD=
