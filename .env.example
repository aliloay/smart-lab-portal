# docker compose reads this file. Copy to .env and set real values.
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-48
DEVICE_API_KEY=change-me-must-match-the-firmware
ENVIRONMENT=production
CORS_ORIGINS=http://localhost

# --- automation (optional, see docs/AUTOMATION.md) ---------------------------
# Leave empty to run without n8n. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTOMATION_API_KEY=
# Self-hosted n8n from the compose `automation` profile:
#   AUTOMATION_WEBHOOK_BASE=http://n8n:5678/webhook
AUTOMATION_WEBHOOK_BASE=
AUTOMATION_WEBHOOK_TOKEN=
N8N_ENCRYPTION_KEY=
