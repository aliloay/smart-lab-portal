# ---------------------------------------------------------------------------
# Smart Lab Portal - backend configuration
# Copy to .env and change every secret before any real deployment.
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql+psycopg://smartlab:smartlab@localhost:5432/smartlab

# Signs the login JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app REFUSES to start in production while this is the default.
SECRET_KEY=dev-only-change-me

# Shared key the ESP32 master sends as X-Device-Key. Must match DEVICE_KEY in
# the firmware. Generate the same way as SECRET_KEY.
DEVICE_API_KEY=dev-device-key-change-me

ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Where the browser app is served from.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Booking policy
MAX_BOOKING_HOURS=8
BOOKING_AUTO_APPROVE=true
# Minutes of tolerance either side of a booking window. 0 is strict.
BOOKING_GRACE_MINUTES=0

# 16 bytes keeps the QR at version 3 (37 modules), which is what makes it
# reliably scannable by the ESP32-CAM. Raising it shrinks the modules.
QR_TOKEN_BYTES=16

# Issue photos. Stored on the local filesystem under UPLOAD_DIR for now; the
# storage service can be pointed at S3/MinIO later without schema changes.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=12
MAX_PHOTOS_PER_ISSUE=12

# Hours before an unresolved issue counts as overdue, by severity.
ISSUE_SLA_HOURS_CRITICAL=24
ISSUE_SLA_HOURS_HIGH=72
ISSUE_SLA_HOURS_MEDIUM=168
ISSUE_SLA_HOURS_LOW=336

# A device with no heartbeat for this long is shown offline.
DEVICE_STALE_SECONDS=90

# --- automation (n8n), optional - see docs/AUTOMATION.md ---------------------
# Key n8n sends as X-Automation-Key. Empty = /api/automation disabled (503).
AUTOMATION_API_KEY=
# Where events are pushed, e.g. http://n8n:5678/webhook. Empty = pull only.
AUTOMATION_WEBHOOK_BASE=
# Sent as X-Smartlab-Token; checked by the n8n webhook Header Auth credential.
AUTOMATION_WEBHOOK_TOKEN=
AUTOMATION_PUSH_TYPES=booking.confirmed,access.denied,issue.created,device.offline,door.alarm
# Rules
DENIAL_WINDOW_MINUTES=10
DENIAL_WARNING_COUNT=3
DEVICE_ESCALATE_L2_MINUTES=15
DEVICE_ESCALATE_L3_MINUTES=60
LAB_OPEN_HOURS_PER_DAY=10
LOCAL_TIMEZONE=Africa/Cairo
SENSOR_THRESHOLDS=temperature=16:30,humidity=20:70,co2=:1000,noise=:85

# --- AI assistant (optional, see docs/AI_ASSISTANT.md) ------------------------
# auto = Claude if ANTHROPIC_API_KEY is set, else the free local Ollama model.
# ollama = always use the free local model.  anthropic = always Claude.
AI_PROVIDER=auto
# Free: install Ollama (ollama.com), then: ollama pull qwen2.5:3b
# (launch.bat does the download for you the first time.)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Student chat model. Empty = same as OLLAMA_MODEL, which is fastest on a
# small GPU: one model stays loaded instead of two swapping in and out.
OLLAMA_STUDENT_MODEL=
# true = run the AI on the processor only (use if Ollama reports a CUDA error)
OLLAMA_CPU_ONLY=false
AI_STUDENT_ENABLED=true
# Paid alternative: key from console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_STUDENT_MODEL=claude-haiku-4-5
AI_EFFORT=medium
AI_MAX_TOOL_ROUNDS=6
AI_QUESTIONS_PER_HOUR=30

# --- Self-service sign-up (login page "Sign up" tab) ---
# Sign-up only creates STUDENT accounts. Each gets the next door identity
# (USERn); it opens nothing until staff enrol that person's fingerprint/face.
SIGNUP_ENABLED=true
# Restrict to university emails, e.g. giu-uni.de (empty = any domain)
SIGNUP_EMAIL_DOMAINS=
# true = new accounts stay disabled until an admin activates them
SIGNUP_REQUIRES_APPROVAL=false
