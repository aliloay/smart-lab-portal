# Keep the image to the code. Configuration comes from docker-compose.yml,
# never from a developer's local .env (which holds their own database
# password and keys).
.env
.env.*
!.env.example

# A Windows virtualenv does not run in a Linux container.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Issue photos live in the "uploads" volume, not in the image.
uploads/

*.log
*.dump
*.backup

# 2026-11-18: a stale local version stamp (28 Oct, 1be41ab) was baked into newer images by `COPY . .`.
# The stamp now comes only from build args (app/main.py _build_info).
app/build_info.json
