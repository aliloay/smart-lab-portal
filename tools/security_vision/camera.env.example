rem Copy this file to camera.env (it stays on this laptop, never in git) and
rem fill it in. launch.bat starts the security camera only when camera.env exists.

rem The camera: its RTSP address (stream2 = light stream for detection), or 0
rem for the laptop webcam while testing. Mercusys/Tapo: the "Camera Account"
rem created in the app, and the camera's fixed IP on Smart_Lab.
set SOURCE=rtsp://camuser:campassword@192.168.1.155:554/stream2

rem Which lab it watches and its id in the portal.
set LAB=LAB_01
set DEVICE=SECCAM_LAB01
