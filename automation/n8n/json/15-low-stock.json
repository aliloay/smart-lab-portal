{
  "id": "VzICtIpS27WGPhJF",
  "name": "Smart Lab 15 - Consumable below reorder level",
  "active": false,
  "nodes": [
    {
      "id": "bdcf7a08-89d7-5b6f-a87a-2e1eaaff95a6",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        100,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "ec09cd50-f4a6-5b91-a657-51ba17ab8319",
      "name": "Check In Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        300,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "http://backend:8000/api/automation/robotics/low-stock",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Smart Lab automation key"
        }
      }
    },
    {
      "id": "94b22383-5e78-5244-a728-900203706081",
      "name": "One Item Per Finding",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        500,
        300
      ],
      "parameters": {
        "fieldToSplitOut": "items"
      }
    },
    {
      "id": "64797ffb-0ca2-5715-acb2-6ef67eabb703",
      "name": "Notify Staff",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        700,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/automation/notify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ audience: \"staff\", kind: \"LOW_STOCK\", title: String($json.title).slice(0, 160), body: String($json.body).slice(0, 500), link: $json.link, severity: $json.severity, dedupe_key: $json.dedupe_key }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Smart Lab automation key"
        }
      }
    },
    {
      "id": "4d65c2da-9b22-5046-ae82-dd53a9f70260",
      "name": "Record Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/automation/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: \"15-low-stock\", status: \"success\", summary: \"Findings: \" + $(\"Check In Backend\").first().json.count, execution_id: $execution.id }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Smart Lab automation key"
        }
      },
      "executeOnce": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "8e0528e7-67a2-5fd8-ae2c-234ab07c03f3",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        100,
        450
      ],
      "parameters": {
        "content": "## Consumable below reorder level\nEstimated quantity at or below the bin's reorder level. Only calibrated bins are estimated.",
        "color": 4
      }
    }
  ],
  "connections": {
    "Every Hour": {
      "main": [
        [
          {
