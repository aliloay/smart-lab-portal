{
  "id": "kkBmwinhDIURUNqn",
  "name": "Smart Lab 20 - Lab PC offline",
  "active": false,
  "nodes": [
    {
      "id": "961e5239-6054-5ea9-a8ab-da375b6d589a",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        100,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "d68a3cb0-565a-59b4-ae49-9aa6c360edeb",
      "name": "Check In Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        300,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "http://backend:8000/api/automation/robotics/pcs-offline",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Smart Lab automation key"
        }
      }
    },
    {
      "id": "3aa5a441-fd21-5864-a6aa-c5e6ce7c352a",
      "name": "One Item Per Finding",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        500,
        300
      ],
      "parameters": {
        "fieldToSplitOut": "items"
      }
    },
    {
      "id": "36dc16c1-72ac-57ff-a293-ff81a8aac521",
      "name": "Notify Staff",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        700,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/automation/notify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ audience: \"staff\", kind: \"DEVICE_OFFLINE\", title: String($json.title).slice(0, 160), body: String($json.body).slice(0, 500), link: $json.link, severity: $json.severity, dedupe_key: $json.dedupe_key }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Smart Lab automation key"
        }
      }
    },
    {
      "id": "ae54245e-68a5-5c09-a961-9a93f4f68988",
      "name": "Record Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/automation/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: \"20-pc-offline\", status: \"success\", summary: \"Findings: \" + $(\"Check In Backend\").first().json.count, execution_id: $execution.id }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Smart Lab automation key"
        }
      },
      "executeOnce": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "00ea55d0-dfa8-5fa4-a9c6-caa0f56db600",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        100,
        450
      ],
      "parameters": {
        "content": "## Lab PC offline\nA lab PC agent stopped reporting.",
        "color": 4
      }
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Check In Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check In Backend": {
      "main": [
        [
          {
            "node": "One Item Per Finding",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One Item Per Finding": {
      "main": [
        [
          {
            "node": "Notify Staff",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Staff": {
      "main": [
        [
          {
            "node": "Record Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "tags": []
}
