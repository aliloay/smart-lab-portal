# Copy to robot.env (git-ignored) and fill in at the lab. Read-only monitoring.
# UR5e: the ROBOT's own address - pendant: Settings > System > Network.
# NOT 192.168.1.101 (that is the ROS laptop on the External Control screen).
UR5E_IP=
# FANUC ER-4iA / R-30iB Mate Plus: the controller's IP (pendant: MENU > SETUP > Host Comm > TCP/IP).
# Read-only (HTTP GET of /MD/CURPOS.DG). Run fanuc_probe.py --robot <IP> first.
FANUC_IP=

# UR5e Local-mode control agent (tools/ur5e_control/ur_local_control.py, docs/ROBOT_CONTROL.md 2026-10-26)
# UR_AGENT_KEY=<long random string, same value in the backend's .env>
# UR_CONTROL_MODE=dry_run          # dry_run | live (owner sign-off) | off
# UR_PORTAL_PROGRAM=portal_control.urp
# UR_APPROACH_FILE=                # JSON {"poses": [[deg x6], ...]} recorded at commissioning
# Automatic Home when nobody uses the robot (owner sign-off): idle -> countdown (cancel in the twin) -> Home
# UR_AUTO_HOME=off
# UR_AUTO_HOME_IDLE_S=120
# UR_AUTO_HOME_COUNTDOWN_S=20
