{
  "id": "BEoxaJKi19VheL3G",
  "name": "Smart Lab 09 - Pre-booking lab readiness check",
  "active": false,
  "nodes": [
    {
      "id": "236c4d3c-2046-55c0-aa6c-35767b48545e",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        100,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "a9d83088-f332-554e-af6f-e1f0b724179f",
      "name": "Get Bookings In Next Hour",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        300,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "http://backend:8000/api/automation/bookings/upcoming?within_minutes=60",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Smart Lab automation key"
        }
      }
    },
    {
      "id": "6edb397c-8a58-5e5b-a5a6-aad8fb2e2746",
      "name": "One Item Per Booking",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        500,
        300
      ],
      "parameters": {
        "fieldToSplitOut": "bookings"
      }
    },
    {
      "id": "b4228207-9800-5848-a6ba-a28d336ed6a3",
      "name": "Lab Not Ready",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.readiness.level }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "warning"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "47c0909a-8b45-5191-a7b9-170cb99de15f",
      "name": "Warn Student",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/automation/notify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ audience: \"user\", user_id: $json.user_id, kind: \"PRE_BOOKING_CHECK\", title: String(\"Heads-up for your \" + $json.lab_code + \" booking\").slice(0, 160), body: String($json.readiness.warnings.join(\" \") + \" Your booking is unchanged.\").slice(0, 500), link: $json.link, severity: \"warning\", dedupe_key: \"pre-booking:\" + $json.booking_id, booking_id: $json.booking_id }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Smart Lab automation key"
        }
      }
    },
    {
      "id": "61780ae7-8eb5-5fe9-afeb-7095866d4f08",
      "name": "Warn Staff",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/automation/notify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ audience: \"staff\", kind: \"PRE_BOOKING_CHECK\", title: String(\"Lab not ready for booking #\" + $(\"Lab Not Ready\").item.json.booking_id).slice(0, 160), body: String($(\"Lab Not Ready\").item.json.lab_code + \": \" + $(\"Lab Not Ready\").item.json.readiness.warnings.join(\" \")).slice(0, 500), link: \"/admin/bookings\", severity: \"warning\", dedupe_key: \"pre-booking-staff:\" + $(\"Lab Not Ready\").item.json.booking_id }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Smart Lab automation key"
        }
      }
    },
    {
      "id": "8b0b9383-c6c1-500a-af0c-ad02cbede3db",
      "name": "Record Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/automation/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: \"09-pre-booking-check\", status: \"success\", summary: \"Warnings sent\", execution_id: $execution.id }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Smart Lab automation key"
        }
      },
      "executeOnce": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "c50af46f-95eb-502a-aa72-4c812620308f",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        100,
        450
      ],
      "parameters": {
        "content": "## Pre-booking check\nWarns the student and staff when a lab is not ready (controller offline, critical issue). It never cancels or changes a booking.",
        "color": 4
      }
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Get Bookings In Next Hour",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Bookings In Next Hour": {
      "main": [
        [
          {
            "node": "One Item Per Booking",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One Item Per Booking": {
      "main": [
        [
          {
            "node": "Lab Not Ready",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lab Not Ready": {
      "main": [
        [
          {
            "node": "Warn Student",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Warn Student": {
      "main": [
        [
          {
            "node": "Warn Staff",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Warn Staff": {
      "main": [
        [
          {
            "node": "Record Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "tags": []
}
