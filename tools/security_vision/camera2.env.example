rem Camera 2 (MERCUSYS MC200, 1080p). Copy to camera2.env (git-ignored) and fill it in at the lab.
rem Camera 1 (camera.env) is not touched by this file.
rem
rem SOURCE: the RTSP address from the Mercusys app's "Camera Account" (Advanced settings).
rem   Format as for camera 1: rtsp://USER:PASSWORD@<camera IP>:554/stream2
rem   stream2 = small stream for analysis (verify it works and is sharp enough; else stream1).
rem   A "@" or ":" in the password is written as %40 / %3A. Use the camera's REAL IP from the
rem   app / router - do not guess it.
set SOURCE=

rem Same lab as camera 1, its own device id and its own port (camera 1 uses 5100).
set LAB=LAB_01
set DEVICE=SECCAM_LAB02
set PORT=5101
