constexpr uint8_t TFT_MOSI_PIN = 2;   // NOT GPIO4 (fingerprint wiring uses it)
constexpr uint8_t TFT_CS_PIN   = 25;
constexpr uint8_t TFT_DC_PIN   = 32;
constexpr uint8_t TFT_RST_PIN  = 33;

// --- Fingerprint UART ---
