{
  "id": "wb24O1Xymccm2Lw4",
  "name": "Smart Lab 02 - Upcoming booking reminders",
  "active": false,
  "nodes": [
    {
      "id": "809dca1e-5682-5fbe-a3cc-0cbf57af4d89",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        100,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "087c1c53-e3fc-54b8-a2a2-c0cb904a3bfa",
      "name": "Get Bookings Starting Soon",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        300,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "http://backend:8000/api/automation/bookings/upcoming?within_minutes=20",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth"
      },
      "credentials": {
        "httpTemplatedCustomAuth": {
          "name": "Smart Lab automation key"
        }
      }
    },
    {
      "id": "c4a59c00-1c25-5df5-a1d9-13a67b5be025",
      "name": "One Item Per Booking",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        500,
        300
      ],
      "parameters": {
        "fieldToSplitOut": "bookings"
      }
    },
    {
      "id": "0f42283a-9cbb-591a-a931-1f6578aa3a5f",
      "name": "Not Reminded Yet",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.reminder_sent }}",
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "36f6a08d-5dbd-5c3d-a029-39eb6c2903f1",
      "name": "Raise Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://backend:8000/api/automation/bookings/{{ $json.booking_id }}/remind",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}"
      },
      "credentials": {
        "httpTemplatedCustomAuth": {
          "name": "Smart Lab automation key"
        }
      }
    },
    {
      "id": "3e689514-c686-548a-a7fc-c6ebe3015f8e",
      "name": "Record Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/automation/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: \"02-booking-reminders\", status: \"success\", summary: \"Reminders raised: \" + $input.all().filter(i => i.json.created).length, execution_id: $execution.id }) }}"
      },
      "credentials": {
        "httpTemplatedCustomAuth": {
          "name": "Smart Lab automation key"
        }
      },
      "executeOnce": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "88e015d6-ded1-5747-abe5-16c704ecda00",
      "name": "Sticky Note 4aac5dfc",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        100,
        450
      ],
      "parameters": {
        "content": "## Upcoming booking reminders\nIdempotent: the backend raises at most one reminder per booking - shared with the portal's own lazy reminder, so a retry or both paths firing never sends two.",
        "color": 4
      }
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Get Bookings Starting Soon",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Bookings Starting Soon": {
      "main": [
        [
          {
            "node": "One Item Per Booking",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One Item Per Booking": {
      "main": [
        [
          {
            "node": "Not Reminded Yet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Not Reminded Yet": {
      "main": [
        [
          {
            "node": "Raise Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Raise Reminder": {
      "main": [
        [
          {
            "node": "Record Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "tags": []
}
